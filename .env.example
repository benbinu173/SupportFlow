# ---------------------------------------------------------------------------
# SupportFlow — environment template
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Defaults below match the docker-compose infrastructure stack.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- PostgreSQL ------------------------------------------------------------
# Host access to the compose service. Inside compose, host becomes "postgres".
DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5432/supportflow
POSTGRES_USER=supportflow
POSTGRES_PASSWORD=supportflow
POSTGRES_DB=supportflow

# --- Redis -----------------------------------------------------------------
# db 0 = cache/pubsub, db 1 = tests, db 2 = celery broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Auth ------------------------------------------------------------------
# Must be at least 32 characters; startup fails otherwise.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ------------------------------------------------------------------
# Comma-separated. No wildcard: the refresh cookie is sent with credentials.
CORS_ORIGINS=http://localhost:5173

# --- AI --------------------------------------------------------------------
# Generation (Anthropic). Embeddings use a separate provider — see ADR-008.
AI_API_KEY=
AI_MODEL=claude-sonnet-5
EMBEDDING_MODEL=

# --- Object storage (MinIO locally, S3-compatible in production) -----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=supportflow-attachments
S3_REGION=us-east-1

# --- Email (Mailpit locally) -----------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=support@supportflow.local

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
