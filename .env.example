# ---------------------------------------------------------------------------
# SupportFlow — environment template
#
# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Defaults below match the docker-compose infrastructure stack.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# --- PostgreSQL ------------------------------------------------------------
# Host access to the compose service. Inside compose, host becomes "postgres".
DATABASE_URL=postgresql+psycopg://supportflow:supportflow@localhost:5432/supportflow
POSTGRES_USER=supportflow
POSTGRES_PASSWORD=supportflow
POSTGRES_DB=supportflow

# --- Redis -----------------------------------------------------------------
# db 0 = cache/pubsub, db 1 = tests, db 2 = celery broker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# --- Auth ------------------------------------------------------------------
# Must be at least 32 characters; startup fails otherwise.
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password policy. Length only, no character-class rules — NIST SP 800-63B prefers
# length, since composition rules push users toward predictable substitutions.
# PASSWORD_MAX_LENGTH is a denial-of-service ceiling on hashing an absurd payload.
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128

# The refresh cookie: the only credential the browser stores. The name is a setting
# so a deployment can change it. Path and Secure are deliberately *not* settings —
# both are derived in config.py: the path from API_V1_PREFIX so the cookie is never
# sent to a non-auth route, and Secure from ENVIRONMENT so it cannot be forgotten.
REFRESH_COOKIE_NAME=sf_refresh

# --- Rate limiting ---------------------------------------------------------
# Login and registration are keyed per client IP; upload and the AI analysis request are
# keyed per user, because both are authenticated and the address is not the thing worth
# counting there. Login is generous enough for a typo-prone human and tight enough to make
# credential stuffing expensive; registration is tighter because account creation has no
# legitimate high-frequency use. The AI limit is the only one guarding a route whose abuse
# is *billed* rather than suffered — every call past it is spend — and it is set a little
# above what a person reviewing tickets reaches by hand, since the route is a button and
# the ticket has already analyzed itself on creation. Fails open if Redis is unreachable
# (ADR-014).
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_UPLOAD_PER_HOUR=60
RATE_LIMIT_AI_PER_HOUR=30

# --- CORS ------------------------------------------------------------------
# Comma-separated. No wildcard: the refresh cookie is sent with credentials.
CORS_ORIGINS=http://localhost:5173

# --- AI --------------------------------------------------------------------
# Generation. Two providers are implemented — see ADR-008 and ADR-028 — and embeddings
# use a separate one, which is Phase X's to choose.
#
# The three settings below are one decision, not three: the key has to be a credential
# *for* the configured provider, and the model has to be one *that provider serves*.
# Startup refuses a mismatch (backend/app/core/config.py), so a Groq key against
# claude-sonnet-5 is a message naming what to change rather than a 401 from a service
# that was never going to recognise the key.
#
# AI_API_KEY is optional: leaving it empty is a legal configuration, and every
# self-hosted installation that does not want AI starts that way. The failure is loud
# at the point of use — the first call raises "AI_API_KEY is not configured" — rather
# than at import, so a checkout with no key still runs the whole test suite.
#
# Its shape follows the provider: sk-ant-... for Anthropic, gsk_... for Groq.
AI_API_KEY=

# "anthropic", "groq", or "fake". The fake provider answers from a scripted list and
# exists for tests only; configuration refuses it outside ENVIRONMENT=test (spec §60).
AI_PROVIDER=anthropic

# Must be a model with a published rate in backend/app/ai/pricing.py — the ledger
# computes cost_usd at write time, and an unpriced model would record every call as
# free rather than as unpriced. Startup refuses an unknown model, and refuses one
# served by the other provider. For Groq, set:
#   AI_PROVIDER=groq
#   AI_MODEL=openai/gpt-oss-120b
# Groq's free tier bills nothing; the ledger records its published rate regardless,
# so the cost column keeps meaning "what these tokens are worth".
AI_MODEL=claude-sonnet-5

# Output ceiling per call, and the per-call timeout in seconds. A call that is cut off
# at AI_MAX_TOKENS is a billed failure, not a retry: the same input truncates again.
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=30

# Attempts inside one request, and the base for the exponential backoff between them
# (jittered between 0.5x and 1x of the ceiling). Three attempts keeps the whole
# sequence — roughly 1s then 2s — inside a request a person is waiting on.
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=1

# --- Embeddings (Phase X) --------------------------------------------------
# The `AI_*` trio mirrored rather than reused, for the reason that block gives: an
# API key belongs to one provider, and embeddings come from a different vendor by
# design (ADR-008 — Anthropic publishes no embedding model). "openai" or "fake"; the
# fake answers with deterministic vectors and is refused outside ENVIRONMENT=test.
#
# Leaving these blank is a working configuration. An empty key means "no embeddings
# configured", and a knowledge route refuses at the point of use rather than at
# startup; an empty model or provider falls back to the default beside each field.
# Ingesting a document requires a real EMBEDDING_API_KEY (OpenAI).
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval policy (spec §24). Passages scoring below the threshold are treated as
# "the knowledge base does not contain sufficient information" and no model is
# called at all — raising it makes the product refuse more and invent less.
RETRIEVAL_MIN_SIMILARITY=0.3
RETRIEVAL_TOP_K=5

# The ingestion ceiling in bytes, counted as the body streams (never from
# Content-Length). Smaller than the attachment ceiling on purpose: an attachment is
# stored and served back, while a document is read, split, and embedded — every byte
# of it is tokens this deployment pays for.
MAX_KNOWLEDGE_DOCUMENT_BYTES=10485760

# --- Object storage (MinIO locally, S3-compatible in production) -----------
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=supportflow-attachments
S3_REGION=us-east-1

# --- Celery ----------------------------------------------------------------
# Read by `app/core/config.py` from Phase P, when the worker that consumes them was
# built. The broker is Redis db 2, separate from the rate limiter's db 0, so clearing
# one purpose's keys cannot discard the other's work (ADR-022).
#
# The time limits are what stop a hung SMTP conversation from pinning a worker slot: the
# soft limit raises inside the task, the hard limit kills the process.
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=60
CELERY_TASK_TIME_LIMIT_SECONDS=120

# --- SLA -------------------------------------------------------------------
# Read from Phase Q. The interval is how often Celery beat runs the deadline sweep, so it
# is also the bound on how late a warning can be: URGENT's response target is 30 minutes
# with the warning at 80%, so 300 seconds makes the shortest alert at most five minutes
# late. Lower it and the sweep runs more often for the same work; the ticket that has
# already been alerted costs one indexed check and nothing else.
#
# The batch size is a ceiling on how many tickets one organization's sweep will examine,
# so a single tenant's backlog cannot make one task run unbounded.
SLA_SWEEP_INTERVAL_SECONDS=300
SLA_SWEEP_BATCH_SIZE=500

# --- WebSockets -------------------------------------------------------------
# Read from Phase R. A browser cannot set an Authorization header on a WebSocket
# handshake, so the socket is accepted first and the token arrives in a frame after it.
# WS_AUTH_TIMEOUT_SECONDS is how long that window is allowed to stay open: a connection
# that says nothing for this long is closed with 4408 rather than held. Ten seconds is
# generous for one small frame that is already in memory, and short enough that opening
# sockets and abandoning them goes nowhere. See ADR-025.
WS_AUTH_TIMEOUT_SECONDS=10

# How many events one connection may have queued before it is disconnected with 1013. The
# queue is what stops a client that has stopped reading from delaying every other tenant's
# delivery on the instance; the bound is what stops that client from holding a backlog it
# will never render, since it re-reads state over HTTP when it reconnects.
WS_QUEUE_MAX_DEPTH=64

# A single send's ceiling, in seconds. Bounds the one case the queue cannot see: a half-open
# connection that accepts bytes into a buffer nothing will ever drain, so no exception is
# raised and the queue never fills.
WS_SEND_TIMEOUT_SECONDS=10.0

# --- Analytics --------------------------------------------------------------
# Read from Phase S. How long a cached analytics response lives, in seconds.
#
# This is chosen against how stale a dashboard number is allowed to look, not against how
# expensive the aggregate is. Writes move a per-organization version counter that every
# cache key embeds, so a ticket change is reflected immediately in the normal case; this
# TTL is what bounds the two cases the counter cannot cover — the orphaned entries an
# invalidation leaves behind, and a write that happened while Redis was down (ADR-026).
ANALYTICS_CACHE_TTL_SECONDS=300

# --- Email (Mailpit locally) -----------------------------------------------
# Mailpit captures everything and needs no credentials, so in development only the
# first three matter. A real provider in production sets the username, the password,
# and SMTP_STARTTLS=true.
#
# STARTTLS is explicit rather than inferred from the port. Port 587 implying TLS is a
# convention, not a guarantee, and a deployment that forgets it should be visible in
# configuration rather than silently sending credentials over an unencrypted channel.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=support@supportflow.local
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
