# ---------------------------------------------------------------------------
# SupportFlow — production environment template
#
#   cp .env.production.example .env.production
#   # fill in every REQUIRED value below, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d --build
#
# `.env.production` is gitignored by the same rule that covers `.env` (see .gitignore's
# first block). Nothing in this file is a real credential, and nothing in it should ever
# become one — a secret committed here is a secret that has to be rotated.
#
# **Every REQUIRED value has no default on purpose.** `:?` in docker-compose.prod.yml turns a
# missing one into a compose error naming the variable, which is a better failure than a
# container that starts and cannot reach its database.
# ---------------------------------------------------------------------------

# --- Deployment ------------------------------------------------------------
# The hostname Caddy serves and obtains a certificate for. A public name gets Let's Encrypt
# automatically; `localhost` gets Caddy's internal CA, which is what makes the stack
# demonstrable on one machine. REQUIRED.
SITE_ADDRESS=localhost

# There is no ACME_EMAIL here, and that is deliberate rather than an omission. Caddy's `email`
# directive rejects an empty argument, so a variable defaulting to empty makes the deployment
# fail to start — which it did, before this comment existed. A real domain that wants ACME
# expiry notices adds `email ops@your-domain` to the global block in docker/Caddyfile.

# Image names and tag. The default builds locally; set these to pull published images
# instead — see the README's deployment section for the GHCR digests a release produces.
# BACKEND_IMAGE=ghcr.io/OWNER/supportflow-backend
# FRONTEND_IMAGE=ghcr.io/OWNER/supportflow-frontend
IMAGE_TAG=latest

# --- Application -----------------------------------------------------------
# **Not "development".** This value decides three things that must not be wrong in a
# deployment: the refresh cookie is only marked `Secure` outside development, the interactive
# docs are only served outside production, and the fake AI providers are refused unless the
# environment is `test`.
ENVIRONMENT=production
DEBUG=false

# Leave at INFO unless diagnosing something. DEBUG logs request bodies in some libraries and
# is not a level a deployment should sit at.
LOG_LEVEL=INFO

# --- PostgreSQL ------------------------------------------------------------
# REQUIRED. The password is the only thing protecting every tenant's data: the database
# publishes no port, but a weak password is still one credential away from total disclosure.
POSTGRES_USER=supportflow
POSTGRES_PASSWORD=
POSTGRES_DB=supportflow

# --- Redis -----------------------------------------------------------------
# db 0 is the cache/rate-limiter/pub-sub space, db 2 is the Celery broker. The split is
# deliberate (ADR-022): clearing rate-limit keys must not be able to discard queued work.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth ------------------------------------------------------------------
# REQUIRED, and **generated, never chosen**:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Configuration refuses to start if this is one of the values published in this repository
# (.env.example's template, or ci.yml's CI-only secret) — see
# `Settings._production_is_not_a_development_checkout`. A signing key an attacker can read
# lets them mint a valid token for any user in any tenant, which is the one credential here
# whose compromise is total.
JWT_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=128
REFRESH_COOKIE_NAME=sf_refresh

# --- CORS ------------------------------------------------------------------
# Comma-separated, exact origins, no wildcard: the refresh cookie is sent with credentials
# and a wildcard is invalid alongside `allow_credentials=True`. In the single-origin
# deployment Caddy creates, this is the site address and nothing else.
CORS_ORIGINS=https://localhost

# --- Rate limiting ---------------------------------------------------------
# Login and registration are keyed per client IP; upload and the AI route per user. Fails
# open if Redis is unreachable (ADR-014), which is a deliberate availability trade.
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_UPLOAD_PER_HOUR=60
RATE_LIMIT_AI_PER_HOUR=30

# --- AI --------------------------------------------------------------------
# Generation. `anthropic` or `groq` — `fake` is refused outside ENVIRONMENT=test (§60).
# REQUIRED for the AI features to work; a blank key is a legal configuration in which the
# first AI call fails loudly rather than the process refusing to start.
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
AI_MAX_TOKENS=1024
AI_TIMEOUT_SECONDS=30
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=1

# --- Embeddings ------------------------------------------------------------
# A separate vendor by design: neither Anthropic nor Groq publishes an embedding model
# (ADR-008). REQUIRED for the knowledge base to ingest or search anything; without it the
# knowledge routes refuse at the point of use and everything else works.
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Retrieval policy (§24). Below the threshold the product answers with its refusal sentence
# and calls no model at all — raising it makes the system decline more and invent less.
RETRIEVAL_MIN_SIMILARITY=0.3
RETRIEVAL_TOP_K=5
MAX_KNOWLEDGE_DOCUMENT_BYTES=10485760

# --- Object storage --------------------------------------------------------
# MinIO in this compose file. On a real deployment these become an S3 bucket, an IAM key,
# and its region, and the `minio` service is removed from docker-compose.prod.yml.
#
# **The bucket is private.** Attachments are served through the API, which checks tenancy
# first; a public-read bucket would make every tenant's uploads readable by anyone who can
# guess a key.
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=supportflow-attachments
S3_REGION=us-east-1

# --- Celery ----------------------------------------------------------------
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=60
CELERY_TASK_TIME_LIMIT_SECONDS=120
# How many tasks one worker container runs at once. Each holds a slot for up to the timeout
# above, so this is also the number of slow AI calls that can be in flight at once.
WORKER_CONCURRENCY=4

# --- SLA -------------------------------------------------------------------
SLA_SWEEP_INTERVAL_SECONDS=300
SLA_SWEEP_BATCH_SIZE=500

# --- WebSockets ------------------------------------------------------------
WS_AUTH_TIMEOUT_SECONDS=10
WS_QUEUE_MAX_DEPTH=64
WS_SEND_TIMEOUT_SECONDS=10.0

# --- Analytics -------------------------------------------------------------
ANALYTICS_CACHE_TTL_SECONDS=300

# --- Email -----------------------------------------------------------------
# A real provider. Mailpit is not part of the production stack: it captures mail instead of
# sending it, which is exactly what a demo needs and exactly what production must not do.
# STARTTLS stays explicit rather than inferred from the port.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=support@example.com
SMTP_TIMEOUT_SECONDS=10
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
