# SupportFlow's single-origin Free Render demo.
# Copy to .env.render.local and fill the remaining values there, or enter them
# directly on the Render service's Environment page. Real values stay gitignored.
ENVIRONMENT=production
DEBUG=false
KNOWLEDGE_ENABLED=false
PORT=10000
# Neon direct hostname; keep TLS params and use sslmode=verify-full&sslrootcert=system.
DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
JWT_SECRET=
PUBLIC_APP_URL=
CORS_ORIGINS=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=supportflow-attachments
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMTP_HOST=mail.smtp2go.com
SMTP_PORT=2525
SMTP_STARTTLS=true
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
EMBEDDING_API_KEY=
