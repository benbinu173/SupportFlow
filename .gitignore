# ---------------------------------------------------------------------------
# Secrets — never commit real environment files. Only .env.example is tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Celery beat's schedule file, written by `make beat`. It records the last time each entry
# ran — per-machine state, not configuration — and a stale one committed by accident would
# make somebody else's beat skip its first sweep.
.celerybeat-schedule
celerybeat-schedule*

# --- Node ------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
coverage/

# --- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Local downloads -------------------------------------------------------
# Nothing this project builds is a native installer, and a stray 40 MB binary in
# the working directory is a `git add -A` away from being committed. If a real
# one is ever needed, force-add it.
*.exe
*.msi
*.dmg

# --- Local infra volumes ---------------------------------------------------
docker/volumes/

# --- Tooling state ---------------------------------------------------------
# Claude Code's `.claude/` uses the same two-file convention as the editors above:
# a project file meant to be shared and a `.local` one that never is. Only the
# second is true here — both files are permission allowlists accumulated on one
# machine, full of absolute Windows paths and scratch junit filenames. Nothing in
# either is a statement about the project, so the whole directory is local.
#
# This is the rule the `.env` block at the top makes: committed config is config
# another checkout needs. If a genuinely shared setting ever appears here, force-add
# that one file.
.claude/
