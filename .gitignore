# ---------------------------------------------------------------------------
# Secrets — never commit real environment files. Only .env.example is tracked.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Celery beat's schedule file, written by `make beat`. It records the last time each entry
# ran — per-machine state, not configuration — and a stale one committed by accident would
# make somebody else's beat skip its first sweep.
.celerybeat-schedule
celerybeat-schedule*

# --- Node ------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
coverage/

# --- Editors / OS ----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Local downloads -------------------------------------------------------
# Nothing this project builds is a native installer, and a stray 40 MB binary in
# the working directory is a `git add -A` away from being committed. If a real
# one is ever needed, force-add it.
*.exe
*.msi
*.dmg

# --- Local infra volumes ---------------------------------------------------
docker/volumes/
